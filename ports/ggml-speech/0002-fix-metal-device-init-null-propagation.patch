From: QVAC SDK Pod <noreply@tether.io>
Subject: [PATCH] ggml-metal: harden device init / propagate NULL on Metal init failure

Crash repro on iPhone 16 (iOS 18, A18 chip), QVACTestConsumer with the
chatterbox TTS suite, useGPU=true:

  Exception Type:  EXC_BAD_ACCESS (SIGKILL)
  Exception Codes: KERN_PROTECTION_FAILURE at 0x0000000000000000
  Triggered by Thread:  6

  Thread 6 (the offending t3 init_backend background thread):
    0   ???                          0x0          0x0  (PC = 0x0)
    1   qvac__tts-ggml...            ggml_metal_device_init  + 0x19b720
    2   qvac__tts-ggml...            ggml_metal_device_get
    3   qvac__tts-ggml...            ggml_backend_metal_reg
    4   qvac__tts-ggml...            ggml_backend_metal_init
    5   qvac__tts-ggml...            tts_cpp::chatterbox::detail::init_backend(int)
    6   qvac__tts-ggml...            tts_cpp::chatterbox::detail::load_model_gguf(...)
    7   qvac__tts-ggml...            tts_cpp::chatterbox::Engine::Impl::Impl(...)

PC = 0x0 means we transferred control through a NULL function pointer
from inside ggml_metal_device_init. Reproduces deterministically across
4+ consecutive QVACTestConsumer launches on the same physical device.

Root cause analysis: ggml_metal_device_init has two failure paths that
do NOT abort:

  1. MTLCreateSystemDefaultDevice() returns nil (Metal genuinely
     unavailable, GPU was reset, or platform-specific transient init
     failure). The function falls through, returns the half-init'd
     `dev` whose mtl_device / mtl_queue / library / rsets are all nil.

  2. ggml_metal_library_init(dev) returns NULL (default.metallib not
     found AND source compile failed). The function logs the error
     but again returns the half-init'd `dev` with `dev->library == NULL`.

Either path is sufficient: downstream call sites
(ggml_backend_metal_init -> ggml_metal_init) eventually deref the
pipeline / library / queue indirection, and on iOS 18 the resulting
NULL function-pointer call lands at PC = 0x0 instead of trapping at a
small offset. The crash signature ("PC = 0x0, LR inside
ggml_metal_device_init") is consistent with an inlined accessor that
read NULL out of the half-init'd struct and tail-called through it.

Fix: bail cleanly from ggml_metal_device_init when MTLCreateSystemDefaultDevice
or ggml_metal_library_init fail (free what we allocated, return NULL),
and propagate that NULL up through:

  ggml_metal_device_get
    -> ggml_backend_metal_device_init
       -> ggml_backend_metal_reg
          -> ggml_backend_metal_init

so the Metal backend init returns NULL to its caller. Sibling
init_backend functions in tts-cpp / llama.cpp / parakeet already check
the return value of ggml_backend_metal_init() and fall through to
the CPU backend on NULL, so this turns a hard crash into a clean
"Metal not available, using CPU backend" recovery path.

Also adds NULL guards to ggml_metal_device_get_obj/get_queue/get_library
so any future caller that holds a stale device handle cannot reproduce
the same SIGSEGV.

---
 src/ggml-metal/ggml-metal-device.cpp |  6 +++++-
 src/ggml-metal/ggml-metal-device.m   | 26 +++++++++++++++++++++-----
 src/ggml-metal/ggml-metal.cpp        | 23 ++++++++++++++++++++---
 3 files changed, 46 insertions(+), 9 deletions(-)

diff --git a/src/ggml-metal/ggml-metal-device.cpp b/src/ggml-metal/ggml-metal-device.cpp
index 5d93363..fdd98e8 100644
--- a/src/ggml-metal/ggml-metal-device.cpp
+++ b/src/ggml-metal/ggml-metal-device.cpp
@@ -20,7 +20,11 @@ typedef std::unique_ptr<ggml_metal_device, ggml_metal_device_deleter> ggml_metal
 ggml_metal_device_t ggml_metal_device_get(int device) {
     static std::vector<ggml_metal_device_ptr> devs;
 
-    devs.emplace_back(ggml_metal_device_init(device));
+    ggml_metal_device_t raw = ggml_metal_device_init(device);
+    if (raw == NULL) {
+        return NULL;
+    }
+    devs.emplace_back(raw);
 
     return devs.back().get();
 }
diff --git a/src/ggml-metal/ggml-metal-device.m b/src/ggml-metal/ggml-metal-device.m
index 5d0eb24..3513500 100644
--- a/src/ggml-metal/ggml-metal-device.m
+++ b/src/ggml-metal/ggml-metal-device.m
@@ -630,7 +630,13 @@ ggml_metal_device_t ggml_metal_device_init(int device) {
     if (dev->mtl_device == nil) {
         dev->mtl_device = MTLCreateSystemDefaultDevice();
 
-        if (dev->mtl_device) {
+        if (dev->mtl_device == nil) {
+            GGML_LOG_ERROR("%s: error: MTLCreateSystemDefaultDevice returned nil - Metal not available on this device\n", __func__);
+            free(dev);
+            return NULL;
+        }
+
+        {
             dev->mtl_queue = [dev->mtl_device newCommandQueue];
             if (dev->mtl_queue == nil) {
                 GGML_LOG_ERROR("%s: error: failed to create command queue\n", __func__);
@@ -804,7 +810,17 @@ ggml_metal_device_t ggml_metal_device_init(int device) {
 
             dev->library = ggml_metal_library_init(dev);
             if (!dev->library) {
-                GGML_LOG_ERROR("%s: error: failed to create library\n", __func__);
+                GGML_LOG_ERROR("%s: error: failed to create library - aborting Metal init\n", __func__);
+                if (dev->mtl_queue) {
+                    [dev->mtl_queue release];
+                    dev->mtl_queue = nil;
+                }
+                if (dev->mtl_device) {
+                    [dev->mtl_device release];
+                    dev->mtl_device = nil;
+                }
+                free(dev);
+                return NULL;
             }
 
             if (dev->props.use_residency_sets) {
@@ -883,15 +899,15 @@ void ggml_metal_device_free(ggml_metal_device_t dev) {
 }
 
 void * ggml_metal_device_get_obj(ggml_metal_device_t dev) {
-    return dev->mtl_device;
+    return dev ? dev->mtl_device : NULL;
 }
 
 void * ggml_metal_device_get_queue(ggml_metal_device_t dev) {
-    return dev->mtl_queue;
+    return dev ? dev->mtl_queue : NULL;
 }
 
 ggml_metal_library_t ggml_metal_device_get_library(ggml_metal_device_t dev) {
-    return dev->library;
+    return dev ? dev->library : NULL;
 }
 
 void ggml_metal_device_rsets_add(ggml_metal_device_t dev, ggml_metal_rset_t rset) {
diff --git a/src/ggml-metal/ggml-metal.cpp b/src/ggml-metal/ggml-metal.cpp
index aaea1a2..dd2f221 100644
--- a/src/ggml-metal/ggml-metal.cpp
+++ b/src/ggml-metal/ggml-metal.cpp
@@ -585,8 +585,17 @@ static ggml_guid_t ggml_backend_metal_guid(void) {
 }
 
 ggml_backend_t ggml_backend_metal_init(void) {
-    ggml_backend_dev_t dev = ggml_backend_reg_dev_get(ggml_backend_metal_reg(), 0);
-    ggml_metal_device_t ctx_dev = (ggml_metal_device_t)dev->context;
+    ggml_backend_reg_t reg = ggml_backend_metal_reg();
+    if (reg == NULL || ggml_backend_reg_dev_count(reg) == 0) {
+        GGML_LOG_ERROR("%s: error: no Metal devices available\n", __func__);
+        return NULL;
+    }
+    ggml_backend_dev_t dev = ggml_backend_reg_dev_get(reg, 0);
+    ggml_metal_device_t ctx_dev = (ggml_metal_device_t)(dev ? dev->context : NULL);
+    if (ctx_dev == NULL) {
+        GGML_LOG_ERROR("%s: error: Metal device init failed - falling back to CPU\n", __func__);
+        return NULL;
+    }
 
     ggml_metal_t ctx = ggml_metal_init(ctx_dev);
     if (ctx == NULL) {
@@ -881,10 +890,14 @@ static ggml_backend_reg_i ggml_backend_metal_reg_i = {
 };
 
 static ggml_backend_dev_t ggml_backend_metal_device_init(ggml_backend_reg_t reg, int device) {
+    ggml_metal_device_t ctx = ggml_metal_device_get(device);
+    if (ctx == NULL) {
+        return NULL;
+    }
     return new ggml_backend_device {
         /* .iface   = */ ggml_backend_metal_device_i,
         /* .reg     = */ reg,
-        /* .context = */ ggml_metal_device_get(device),
+        /* .context = */ ctx,
     };
 }
 
@@ -920,6 +933,10 @@ ggml_backend_reg_t ggml_backend_metal_reg(void) {
 
             for (int i = 0; i < g_devices; ++i) {
                 auto * dev = ggml_backend_metal_device_init(&reg, i);
+                if (dev == NULL) {
+                    GGML_LOG_ERROR("%s: error: failed to init Metal device %d - skipping\n", __func__, i);
+                    continue;
+                }
                 devs.emplace_back(dev);
 
                 reg_ctx->devices.push_back(dev);
