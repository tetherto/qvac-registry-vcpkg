diff --git a/ggml/CMakeLists.txt b/ggml/CMakeLists.txt
index 99a350d9b..86640afee 100644
--- a/ggml/CMakeLists.txt
+++ b/ggml/CMakeLists.txt
@@ -84,6 +84,14 @@ endif()

 option(BUILD_SHARED_LIBS           "ggml: build shared libraries" ${BUILD_SHARED_LIBS_DEFAULT})
 option(GGML_BACKEND_DL             "ggml: build backends as dynamic libraries (requires BUILD_SHARED_LIBS)" OFF)
+option(GGML_SHARED_CORE "ggml: build QVAC shared core libraries independently of llama linkage" OFF)
+if (GGML_SHARED_CORE)
+    if (NOT CMAKE_SYSTEM_NAME MATCHES "^(Linux|Windows|Android)$" OR NOT GGML_BACKEND_DL)
+        message(FATAL_ERROR "GGML_SHARED_CORE requires dynamic backends on Linux, Windows or Android")
+    endif()
+    # Scope this to ggml; llama and its helpers retain the parent linkage.
+    set(BUILD_SHARED_LIBS ON)
+endif()
 set(GGML_BACKEND_DIR "" CACHE PATH "ggml: directory to load dynamic backends from (requires GGML_BACKEND_DL")

 #
